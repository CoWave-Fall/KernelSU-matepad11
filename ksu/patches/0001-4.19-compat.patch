+/* 在快照策略里把上下文串解析成 sid */
+static int hide_backup_context_to_sid(const char *scontext, u32 scontext_len, u32 *sid)
+{
+    struct ksu_sepolicy_backup *backup = backup_sepolicy;
+    struct context ctx;
+    char *copy;
+    int rc;
+
+    *sid = SECSID_NULL;
+    if (!backup)
+        return -EAGAIN;
+    if (!scontext_len)
+        return -EINVAL;
+
+    copy = kmemdup_nul(scontext, scontext_len, GFP_KERNEL);
+    if (!copy)
+        return -ENOMEM;
+
+    rc = hide_string_to_context(&backup->policydb, backup->sidtab, copy, &ctx, SECSID_NULL);
+    if (!rc) {
+        rc = context_add_hash(&backup->policydb, &ctx);
+        if (!rc)
+            rc = sidtab_context_to_sid(backup->sidtab, &ctx, sid);
+        context_destroy(&ctx);
+    }
+
+    kfree(copy);
+    return rc;
+}
+
+/* 在线上策略里把上下文串解析成 sid，取的是真实可切入的 sid */
+static int hide_live_context_to_sid(const char *scontext, u32 scontext_len, u32 *sid)
+{
+    struct selinux_ss *ss = selinux_state.ss;
+    struct context ctx;
+    char *copy;
+    int rc;
+
+    *sid = SECSID_NULL;
+    if (!scontext_len)
+        return -EINVAL;
+
+    copy = kmemdup_nul(scontext, scontext_len, GFP_KERNEL);
+    if (!copy)
+        return -ENOMEM;
+
+    read_lock(&ss->policy_rwlock);
+    rc = hide_string_to_context(&ss->policydb, ss->sidtab, copy, &ctx, SECSID_NULL);
+    if (!rc) {
+        rc = context_add_hash(&ss->policydb, &ctx);
+        if (!rc)
+            rc = sidtab_context_to_sid(ss->sidtab, &ctx, sid);
+        context_destroy(&ctx);
+    }
+    read_unlock(&ss->policy_rwlock);
+
+    kfree(copy);
+    return rc;
+}
+
+/* 在快照策略里把 sid 还原成上下文串 */
+static int hide_backup_sid_to_context(u32 sid, char **scontext, u32 *scontext_len)
+{
+    struct ksu_sepolicy_backup *backup = backup_sepolicy;
+    struct context *ctx;
+
+    if (scontext)
+        *scontext = NULL;
+    *scontext_len = 0;
+    if (!backup)
+        return -EAGAIN;
+
+    ctx = sidtab_search(backup->sidtab, sid);
+    if (!ctx) {
+        pr_err("SELinux: %s:  unrecognized SID %d\n", __func__, sid);
+        return -EINVAL;
+    }
+
+    return hide_context_struct_to_string(&backup->policydb, ctx, scontext, scontext_len);
+}
