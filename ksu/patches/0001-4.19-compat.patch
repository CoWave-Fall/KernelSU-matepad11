+/*
+ * 4.19 的策略没有可替换副本，注入直接改写 selinux_state.ss->policydb。
+ * 原地改写没有回滚手段：协议解析中途出错时，已经应用的命令保留，返回值反映
+ * 解析结果。
+ */
+int handle_sepolicy(void __user *user_data, u64 data_len)
+{
+    struct selinux_ss *ss;
+    struct policydb *db;
+    struct sepol_batch_cursor cursor;
+    u8 *payload;
+    void *scratch = NULL;
+    size_t scratch_size = 0;
+    int ret;
+    int parse_ret = 0;
+    int success_cmd_count = 0;
+    u32 cmd_index = 0;
+
+    if (!user_data || !data_len)
+        return -EINVAL;
+
+    if (data_len > KSU_SEPOLICY_MAX_BATCH_SIZE)
+        return -E2BIG;
+
+    payload = vmalloc((size_t)data_len);
+    if (!payload)
+        return -ENOMEM;
+
+    if (copy_from_user(payload, user_data, (size_t)data_len)) {
+        ret = -EFAULT;
+        goto out_free;
+    }
+
+    if (!getenforce())
+        pr_info("SELinux permissive or disabled when handle policy!\n");
+
+    ss = selinux_state.ss;
+    db = &ss->policydb;
+
+    scratch_size = db->len * 2 + 4096;
+    scratch = vmalloc(scratch_size);
+    if (!scratch)
+        pr_warn("sepol: no scratch buffer for policy length\n");
+
+    write_lock_irq(&ss->policy_rwlock);
+
+    cursor.cur = payload;
+    cursor.end = payload + (size_t)data_len;
+
+    while (cursor.cur < cursor.end) {
+        struct sepol_data header;
+        const char *args[KSU_SEPOLICY_MAX_ARGS] = { 0 };
+        u32 arg_index;
+        int expected_argc;
+
+        parse_ret = sepol_read_cmd_header(&cursor, &header);
+        if (parse_ret < 0) {
+            pr_err("sepol: failed to read cmd header #%u.\n", cmd_index);
+            break;
+        }
+
+        expected_argc = sepol_expected_argc(header.cmd);
+        if (expected_argc < 0 || expected_argc > KSU_SEPOLICY_MAX_ARGS) {
+            parse_ret = -EINVAL;
+            pr_err("sepol: invalid cmd header #%u.\n", cmd_index);
+            break;
+        }
+
+        for (arg_index = 0; arg_index < (u32)expected_argc; arg_index++) {
+            parse_ret = sepol_read_string(&cursor, &args[arg_index]);
+            if (parse_ret < 0) {
+                pr_err("sepol: failed to read cmd #%u arg #%u.\n", cmd_index, arg_index);
+                break;
+            }
+        }
+        if (parse_ret < 0)
+            break;
+
+        if (apply_one_sepolicy_cmd(db, &header, args) < 0)
+            pr_err("sepol: cmd #%u failed, cmd=%u subcmd=%u.\n", cmd_index, header.cmd, header.subcmd);
+        else
+            success_cmd_count++;
+        cmd_index++;
+    }
+
+    if (cmd_index > 0)
+        ksu_refresh_policydb_len_locked(db, scratch, scratch_size);
+
+    write_unlock_irq(&ss->policy_rwlock);
+    vfree(scratch);
+
+    /* 原地改写没有回滚手段，已经写入的策略必须让 avc 立即失效 */
+    if (cmd_index > 0)
+        reset_avc_cache();
+
+    ret = parse_ret < 0 ? parse_ret : success_cmd_count;
+
+out_free:
+    vfree(payload);
+
+    return ret;
+}
+#endif
