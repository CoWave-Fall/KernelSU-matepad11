+        if (IS_ERR(backup_sepolicy)) {
+            pr_err("failed to create backup sepolicy: %ld\n", PTR_ERR(backup_sepolicy));
+            backup_sepolicy = NULL;
+        } else {
+            pr_info("backup sepolicy success! latest_granting=%u\n", backup_sepolicy->latest_granting);
+        }
+    }
+
+    scratch_size = db->len * 2 + 4096;
+    scratch = vmalloc(scratch_size);
+    if (!scratch)
+        pr_warn("sepol: no scratch buffer for policy length\n");
