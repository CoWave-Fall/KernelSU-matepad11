+/*
+ * 4.19 的 SELinux 没有 struct selinux_policy：策略与 sidtab 常驻
+ * selinux_state.ss，KSU 的规则由 apply_kernelsu_rules() 原地注入。为了让普通
+ * 应用看不到这些注入，这里保留注入前的策略快照 backup_sepolicy，凡来自应用
+ * （uid >= 10000）的上下文校验与访问判定都改由快照回答。
+ *
+ * 快照的 sidtab 与线上 sidtab 各自独立编号，快照 sid 只在快照内部有效；
+ * setprocattr 需要真正切入的域时，再用线上策略解析一次取线上 sid。
+ *
+ * 与 5.10 实现的差异：
+ *   - 4.19 没有 sidtab_search_entry()/sidtab_sid2str_*()，改用 sidtab_search()
+ *     后每回直接序列化上下文，不做字符串缓存；
+ *   - sidtab_context_to_sid() 依赖 context->hash，转 sid 之前必须
+ *     context_add_hash()；
+ *   - type_attr_map_array / type_val_to_struct_array 是 flex_array；
+ *   - 状态页与状态锁在 selinux_state.ss 下。
+ */
+
+static DEFINE_MUTEX(selinux_hide_mutex);
+static bool ksu_selinux_hide_enabled __read_mostly = false;
+static bool ksu_selinux_hide_running __read_mostly = false;
+
+typedef ssize_t (*write_op_fn)(struct file *, char *, size_t);
+
+static write_op_fn *context_write, *access_write;
+static write_op_fn orig_context_write, orig_access_write;
+
+static DEFINE_STATIC_KEY_FALSE(fake_status_initialize_key);
+static struct page *fake_status = NULL;
+
+static void (*security_dump_masked_av_fn)(struct policydb *policydb, struct context *scontext,
+                                          struct context *tcontext, u16 tclass, u32 permissions, const char *reason) = NULL;
+static void (*context_struct_compute_av_fn)(struct policydb *policydb, struct context *scontext,
+                                            struct context *tcontext, u16 tclass, struct av_decision *avd,
+                                            struct extended_perms *xperms) = NULL;
+
+/*
+ * security/selinux/selinuxfs.c 的 write_op[] 是 static 数组，4.19 既不导出数组也
+ * 不导出下标枚举。这里先解析 sel_write_context / sel_write_access 的地址，再在
+ * write_op 的符号范围内按指针值定位槽位，顺带不依赖 inode 编号。
+ */
+static write_op_fn *find_write_op_slot(const char *fn_name)
+{
+    unsigned long table = find_kernel_symbol_exact("write_op");
+    unsigned long fn = find_kernel_symbol_exact(fn_name);
+    unsigned long size = 0;
+    size_t off;
+
+    if (!table || !fn)
+        return NULL;
+    if (!kallsyms_lookup_size_offset(table, &size, NULL) || size < sizeof(void *))
+        return NULL;
+
+    for (off = 0; off + sizeof(void *) <= size; off += sizeof(void *)) {
+        write_op_fn *slot = (write_op_fn *)(table + off);
+        if ((unsigned long)(*slot) == fn)
+            return slot;
+    }
+
+    return NULL;
+}
