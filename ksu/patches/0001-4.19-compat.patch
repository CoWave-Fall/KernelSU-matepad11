+ *
+ * scratch 由调用方在取锁前用 vmalloc 分配，容量取策略长度的两倍：单次注入的
+ * 增长量远小于原策略，余量足以覆盖新增节点；policydb_write() 只写调用方缓冲区、
+ * 不做额外分配，可以安全地放在 write_lock_irq 区间内执行。
+ */
+static void ksu_refresh_policydb_len_locked(struct policydb *db, void *scratch, size_t scratch_size)
+{
+    struct policy_file fp;
+    int rc;
+
+    if (!db->policyvers)
+        return;
+
+    if (scratch) {
+        fp.data = scratch;
+        fp.len = scratch_size;
+        rc = policydb_write(db, &fp);
+        if (!rc) {
+            db->len = (size_t)((unsigned long)fp.data - (unsigned long)scratch);
+            return;
+        }
+        pr_warn("sepol: policydb_write failed: %d\n", rc);
+    }
+
+    /* 拿不到准确长度时高估：多占 vmalloc 无害，少算会破坏策略读取缓冲区 */
+    db->len += db->len / 2 + 4096;
