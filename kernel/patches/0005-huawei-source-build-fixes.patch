--- /dev/null
+++ b/drivers/devkit/lcdkit/lcdkit3.0/kernel/qcom/common/include/lcd_kit_dpd.h
@@ -0,0 +1,20 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * 原厂开源包缺少该头文件。lcd_kit_debug.c 只通过 str_convert() 使用
+ * xml_string_name_map 把 dtsi 名称映射到 xml 名称，这里提供一张空表，
+ * 让映射查不到时走原有的 NULL 分支。dpd 状态由 lcd_kit_dbg.h 的
+ * is_dpd_mode() 提供。
+ */
+#ifndef __LCD_KIT_DPD_H__
+#define __LCD_KIT_DPD_H__
+
+struct xml_string_name {
+	char *dtsi_string_name;
+	char *xml_string_name;
+};
+
+static struct xml_string_name xml_string_name_map[] = {
+	{ "", "" },
+};
+
+#endif /* __LCD_KIT_DPD_H__ */
